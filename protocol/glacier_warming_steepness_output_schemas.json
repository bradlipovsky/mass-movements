    "endpoint": ["t2m_trend_k_decade", "slope_deg"],
    "role": ["case", "control"],
    "status": ["DESCRIPTIVE_ONLY", "INDETERMINATE"],
    "direction": ["consistent", "mixed", "inconsistent"]
  },
  "csv_boolean_tokens": ["True", "False"],
